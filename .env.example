# No paid API required for retrieval-only mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_S=15
TOP_K=5

# Start without model downloads: tfidf (lexical baseline).
# For real multilingual semantic embeddings after installing requirements-semantic.txt:
# RAG_EMBEDDING_BACKEND=sentence_transformers
RAG_EMBEDDING_BACKEND=tfidf
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
